{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Connectera: 1. Install (first time)",
      "type": "shell",
      "command": "./setup.sh",
      "windows": { "command": ".\\setup.bat" },
      "problemMatcher": []
    },
    {
      "label": "Connectera: 2. Run the app",
      "type": "shell",
      "command": "./run.sh",
      "windows": { "command": ".\\run.bat" },
      "problemMatcher": []
    },
    {
      "label": "Connectera: Reset demo data",
      "type": "shell",
      "command": ".venv/bin/python manage.py seed --no-download",
      "windows": { "command": ".venv\\Scripts\\python.exe manage.py seed --no-download" },
      "options": { "env": { "PYTHONUTF8": "1" } },
      "problemMatcher": []
    },
    {
      "label": "Connectera: Run tests",
      "type": "shell",
      "command": ".venv/bin/python manage.py test core",
      "windows": { "command": ".venv\\Scripts\\python.exe manage.py test core" },
      "options": { "env": { "PYTHONUTF8": "1" } },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
