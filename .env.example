# Copy this file to ".env" and adapt the values.

# --- Django
SECRET_KEY=change-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# --- MySQL database
DB_NAME=connectera
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Set DB_ENGINE=sqlite to use a local SQLite file instead of MySQL (handy without MySQL installed)
# DB_ENGINE=sqlite

# --- E-mail (by default e-mails — e.g. password reset links — are printed in the terminal)
# To send real e-mails (e.g. Gmail with an "app password"):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your.address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Connectera <your.address@gmail.com>
